# ==========================
# IGNORAR REPOS EMBUTIDOS
# ==========================
alacritty/.config/alacritty/themes/
tmux/.tmux/plugins/

# ==========================
# IGNORAR LIXO GERAL
# ==========================
*.swp
*.tmp
*.log
*~
*.bak

# ==========================
# IGNORAR CACHES COMUNS
# ==========================
.cache/
__pycache__/
Session.vim
tags

# ==========================
# IGNORAR ARQUIVOS DO STOW
# ==========================
.stow-local-ignore

# ==========================
# IGNORAR ARQUIVOS DO SISTEMA
# ==========================
.DS_Store
Thumbs.db

# ==========================
# IGNORAR CONFIGS QUE SE REGERAM
# ==========================
vscode/CachedData/
vscode/Code\ Cache/
vscode/Backups/
vscode/User/globalStorage/

# ==========================
# IGNORAR HISTÓRICO SENSÍVEL
# ==========================
.zsh_history
.bash_history
.fish_history

# ==========================
# IGNORAR TOKENS OU CREDENCIAIS
# ==========================
*.env
*.secret
*.token
*.pem
*.key

# ==========================
# IGNORAR LIXO DO VSCODE
# ==========================
# Ignora tudo dentro de Code, exceto a pasta User
vscode/.config/Code/*
!vscode/.config/Code/User/

# Dentro de User, ignora tudo exceto os 3 arquivos que você quer
vscode/.config/Code/User/*
!vscode/.config/Code/User/extensions.txt
!vscode/.config/Code/User/keybindings.json
!vscode/.config/Code/User/settings.json
